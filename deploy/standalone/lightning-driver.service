[Unit]
Description=Lightning Driver API and UI
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=lightning-driver
Group=lightning-driver
StateDirectory=lightning-driver
StateDirectoryMode=0700
Environment=STATE_DIR=/var/lib/lightning-driver
Environment=HOST=127.0.0.1
WorkingDirectory=/var/lib/lightning-driver
ExecStart=/bin/bash /opt/lightning-driver/run.sh
Restart=on-failure
RestartSec=2
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/lightning-driver
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
